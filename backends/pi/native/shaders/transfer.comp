#version 450

// Four-byte-aligned bitwise copies and fills. Numerical operators belong to
// selected programs; the backend does not silently convert dtypes here.
layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Source { uint words[]; } src;
layout(set = 0, binding = 1, std430) buffer Destination { uint words[]; } dst;
layout(push_constant) uniform Transfer {
    uint source_word;
    uint destination_word;
    uint count;
    uint value;
    uint fill;
} args;

void main() {
    uint i = gl_GlobalInvocationID.x +
             gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * 16u);
    if (i < args.count) {
        dst.words[args.destination_word + i] = args.fill != 0u
            ? args.value : src.words[args.source_word + i];
    }
}
