+/* Fatal containment deliberately has no release operation in contract v1.
+ * Keep the module, device and affected jobs (including BO/PM references) alive
+ * until reboot. An error-signaled fence reports failure, not safe reuse.
+ */
+void
+v3d_csd_poison_device(struct v3d_dev *v3d, int error)
+{
+	if (!cmpxchg(&v3d->csd_error, 0, error)) {
+		/* Live jobs already hold these owners across file close. Keep a
+		 * device-wide hold too; contract v1 has no recovery/unbind path.
+		 * These reference operations do not allocate and are IRQ-safe.
+		 */
+		__module_get(THIS_MODULE);
+		drm_dev_get(&v3d->drm);
+		get_device(v3d->drm.dev);
+		drm_err(&v3d->drm,
+			"Compute completion uncertain (%d); storage retained, reboot required\n",
+			error);
+	}
