+static void
+v3d_job_quarantine(struct v3d_job *job, int error)
+{
+	if (!job->quarantined) {
+		kref_get(&job->refcount);
+		job->quarantined = true;
+	}
+	v3d_csd_poison_device(job->v3d, error);
